// Формирование набора тестовых физических лиц для загрузки в catalog.person.
// Фамилии уникальны — это ключ поиска (searchBy = last_name) для защиты от дублей при повторном запуске.
// title склеивается из ФИО так же, как формула в самом справочнике: last_name + first_name + middle_name.
const people = [
    { last_name: 'Иванов',      first_name: 'Алексей',   middle_name: 'Сергеевич' },
    { last_name: 'Петров',      first_name: 'Дмитрий',   middle_name: 'Иванович' },
    { last_name: 'Смирнов',     first_name: 'Николай',   middle_name: 'Петрович' },
    { last_name: 'Кузнецов',    first_name: 'Андрей',    middle_name: 'Викторович' },
    { last_name: 'Соколов',     first_name: 'Михаил',    middle_name: 'Александрович' },
    { last_name: 'Попов',       first_name: 'Владимир',  middle_name: 'Олегович' },
    { last_name: 'Лебедев',     first_name: 'Сергей',    middle_name: 'Анатольевич' },
    { last_name: 'Козлов',      first_name: 'Игорь',     middle_name: 'Евгеньевич' },
    { last_name: 'Новиков',     first_name: 'Артём',     middle_name: 'Денисович' },
    { last_name: 'Морозов',     first_name: 'Павел',     middle_name: 'Юрьевич' },
    { last_name: 'Волков',      first_name: 'Роман',     middle_name: 'Геннадьевич' },
    { last_name: 'Алексеев',    first_name: 'Максим',    middle_name: 'Васильевич' },
    { last_name: 'Васильева',   first_name: 'Елена',     middle_name: 'Андреевна' },
    { last_name: 'Зайцева',     first_name: 'Ольга',     middle_name: 'Николаевна' },
    { last_name: 'Павлова',     first_name: 'Татьяна',   middle_name: 'Сергеевна' },
    { last_name: 'Семёнова',    first_name: 'Наталья',   middle_name: 'Дмитриевна' },
    { last_name: 'Голубева',    first_name: 'Ирина',     middle_name: 'Алексеевна' },
    { last_name: 'Виноградова', first_name: 'Анна',      middle_name: 'Михайловна' },
    { last_name: 'Богданова',   first_name: 'Мария',     middle_name: 'Викторовна' },
    { last_name: 'Воробьёва',   first_name: 'Светлана',  middle_name: 'Павловна' },
    { last_name: 'Фёдоров',     first_name: 'Денис',     middle_name: 'Игоревич' },
    { last_name: 'Михайлов',    first_name: 'Антон',     middle_name: 'Романович' },
    { last_name: 'Беляев',      first_name: 'Кирилл',    middle_name: 'Олегович' },
    { last_name: 'Тарасов',     first_name: 'Евгений',   middle_name: 'Борисович' },
    { last_name: 'Белова',      first_name: 'Екатерина', middle_name: 'Владимировна' },
    { last_name: 'Комарова',    first_name: 'Юлия',      middle_name: 'Сергеевна' },
    { last_name: 'Орлова',      first_name: 'Виктория',  middle_name: 'Андреевна' },
    { last_name: 'Киселёв',     first_name: 'Григорий',  middle_name: 'Степанович' },
    { last_name: 'Макаров',     first_name: 'Станислав', middle_name: 'Леонидович' },
    { last_name: 'Андреевский',     first_name: 'Тимофей',   middle_name: 'Аркадьевич' }
];

const data = createTable([
    { name: 'last_name', dataType: 'string' },
    { name: 'first_name', dataType: 'string' },
    { name: 'middle_name', dataType: 'string' },
    { name: 'title', dataType: 'string' }
]);

people.forEach(function (p) {
    const title = [p.last_name, p.first_name, p.middle_name].filter(Boolean).join(' ');
    data.addRow({ last_name: p.last_name, first_name: p.first_name, middle_name: p.middle_name, title: title });
});

return data;
