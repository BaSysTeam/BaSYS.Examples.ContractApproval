# Скопируйте этот файл в tests/.env и заполните реальными значениями.
# Файл tests/.env в репозиторий НЕ коммитится (см. tests/.gitignore).

# Базовый адрес стенда BaSYS
BASYS_BASE_URL=https://localhost:44365

# Учётные данные для входа
BASYS_EMAIL=your_email@example.com
BASYS_PASSWORD=your_password_here
BASYS_DB_NAME=your_db_name
